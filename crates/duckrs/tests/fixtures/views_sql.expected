CREATE VIEW aliased (first_name, second_name) AS SELECT 1 AS a, 2 AS b;
CREATE VIEW q1 AS SELECT i, (i + 1) AS "next", s FROM base WHERE (i > 2) ORDER BY i DESC NULLS LAST LIMIT 5 OFFSET 1;
CREATE VIEW q10 AS SELECT i, row_number() OVER (ORDER BY i) AS a, sum(i) OVER (PARTITION BY (i % 2) ORDER BY i ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS b, lag(i, 2, 0) OVER (ORDER BY i) AS c FROM base ORDER BY i;
CREATE VIEW q11 AS SELECT i, first_value(i) OVER (ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS a, last_value(i) OVER (ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS b FROM base ORDER BY i;
CREATE VIEW q12 AS SELECT i FROM base QUALIFY (row_number() OVER (PARTITION BY (i % 2) ORDER BY i) = 1) ORDER BY i;
CREATE VIEW q13 AS SELECT a.i, b.s FROM base AS a INNER JOIN base AS b ON ((a.i = (b.i + 1))) ORDER BY 1;
CREATE VIEW q14 AS SELECT a.i, b.i AS j FROM base AS a LEFT JOIN base AS b USING (i) ORDER BY 1;
CREATE VIEW q15 AS SELECT count_star() AS c FROM base AS a CROSS JOIN base AS b;
CREATE VIEW q16 AS SELECT * FROM base AS a NATURAL INNER JOIN other ORDER BY i;
CREATE VIEW q17 AS SELECT a.i, b.i AS j FROM base AS a , base AS b WHERE (a.i = b.i) ORDER BY 1;
CREATE VIEW q18 AS SELECT i FROM base WHERE EXISTS(SELECT 1 FROM other WHERE (other.i = base.i)) ORDER BY i;
CREATE VIEW q19 AS SELECT i FROM base WHERE (NOT EXISTS(SELECT 1 FROM other WHERE (other.i = base.i))) ORDER BY i;
CREATE VIEW q2 AS SELECT (i % 3) AS k, count_star() AS c, sum(i) FILTER (WHERE (i > 1)) AS f, string_agg(s, ',' ORDER BY i) AS a FROM base GROUP BY ALL HAVING (count_star() > 0) ORDER BY 1;
CREATE VIEW q20 AS SELECT i, (SELECT max(i) FROM other) AS m FROM base WHERE (i = ANY(SELECT i FROM other)) ORDER BY i;
CREATE VIEW q21 AS SELECT i FROM base WHERE (i > ANY(SELECT i FROM other)) ORDER BY i;
CREATE VIEW q22 AS (SELECT i FROM base) UNION ALL (SELECT i FROM other) ORDER BY 1;
CREATE VIEW q23 AS (SELECT i FROM base) UNION (SELECT i FROM other)UNION (SELECT 100) ORDER BY 1;
CREATE VIEW q24 AS (SELECT i FROM base) EXCEPT (SELECT i FROM other) ORDER BY 1;
CREATE VIEW q25 AS (SELECT i FROM base) INTERSECT (SELECT i FROM other) ORDER BY 1;
CREATE VIEW q26 AS (SELECT i FROM base) UNION ALL BY NAME (SELECT i FROM other) ORDER BY 1;
CREATE VIEW q27 AS WITH c AS (SELECT i FROM base), d (x) AS MATERIALIZED (SELECT (i + 1) FROM c)SELECT * FROM d ORDER BY 1;
CREATE VIEW q28 AS WITH RECURSIVE n (x) AS ((SELECT 1) UNION  ALL (SELECT (x + 1) FROM n WHERE (x < 4)))SELECT x FROM n ORDER BY x;
CREATE VIEW q29 AS SELECT * EXCLUDE (s) FROM base ORDER BY i;
CREATE VIEW q3 AS SELECT DISTINCT ON ((i % 2)) i, s FROM base ORDER BY (i % 2), i;
CREATE VIEW q30 AS SELECT * REPLACE ((i + 1) AS i) FROM base ORDER BY i;
CREATE VIEW q31 AS SELECT base.* FROM base ORDER BY i;
CREATE VIEW q32 AS SELECT COLUMNS('^i$') FROM base ORDER BY 1;
CREATE VIEW q33 AS SELECT * FROM (SELECT * FROM (VALUES (1, 'a'), (2, 'b')) AS valueslist) AS t(x, y) ORDER BY x;
CREATE VIEW q34 AS SELECT * FROM "range"(3) AS r(x) ORDER BY x;
CREATE VIEW q35 AS SELECT * FROM (SELECT i AS x FROM base) AS sub WHERE (x > 1) ORDER BY x;
CREATE VIEW q36 AS SELECT main.list_value(1, 2, 3) AS a, main.list_value(1, 2, 3)[2] AS b, main.list_value(1, 2, 3)[1:2] AS c, main.struct_pack(x := 1, y := 'z') AS d, (main.struct_pack(x := 1)).x AS e, main."map"(main.list_value('k'), main.list_value(1)) AS f FROM base LIMIT 1;
CREATE VIEW q37 AS SELECT list_transform(main.list_value(1, 2), (x -> (x + 1))) AS a, list_filter(main.list_value(1, 2, 3), (lambda x: (x > 1))) AS b FROM base LIMIT 1;
CREATE VIEW q38 AS SELECT CAST('2020-01-02' AS "DATE") AS a, CAST('2020-01-02 03:04:05' AS TIMESTAMP) AS b, to_days(CAST(trunc(CAST(1 AS DOUBLE)) AS INTEGER)) AS c, 1000.0 AS e FROM base LIMIT 1;
CREATE VIEW q39 AS SELECT (i % 2) AS k, count_star() AS c FROM base GROUP BY GROUPING SETS ((),((i % 2))) ORDER BY 1 NULLS FIRST;
CREATE VIEW q4 AS SELECT DISTINCT (i % 2) AS m FROM base ORDER BY m;
CREATE VIEW q40 AS SELECT (i % 2) AS k, s, GROUPING(s) AS g FROM base GROUP BY GROUPING SETS (((i % 2)),(s)) ORDER BY 1, 2, 3;
CREATE VIEW q41 AS SELECT twice(i) AS a, add_default(i) AS b, add_default(i, b := 5) AS c FROM base ORDER BY i;
CREATE VIEW q42 AS SELECT * FROM evens() ORDER BY 1;
CREATE VIEW q43 AS SELECT CAST('b' AS "mood") AS m, i FROM base ORDER BY i;
CREATE VIEW q44 AS SELECT i, doubled, "label" FROM with_everything ORDER BY i;
CREATE VIEW q45 AS SELECT * FROM other_schema.t ORDER BY 1;
CREATE VIEW q5 AS SELECT CASE  WHEN ((i < 2)) THEN ('low') WHEN ((i < 4)) THEN ('mid') ELSE 'high' END AS c, CASE  WHEN ((i = 1)) THEN (10) ELSE NULL END AS d FROM base ORDER BY i;
CREATE VIEW q6 AS SELECT CAST(i AS BIGINT) AS a, TRY_CAST(s AS INTEGER) AS b, CAST(i AS DECIMAL(9, 2)) AS c FROM base ORDER BY i;
CREATE VIEW q7 AS SELECT (i BETWEEN 2 AND 3) AS a, (NOT (i BETWEEN 2 AND 3)) AS b, (i IN (1, 2)) AS c, (i NOT IN (1, 2)) AS d, (s IS NULL) AS e, (s IS NOT NULL) AS f, (i != 1) AS g FROM base ORDER BY i;
CREATE VIEW q8 AS SELECT ((i = 1) OR ((i = 2) AND (s != 'x'))) AS a, (i IS DISTINCT FROM 1) AS b, (i IS NOT DISTINCT FROM 1) AS c, COALESCE(s, 'none') AS d, "nullif"(i, 1) AS e FROM base ORDER BY i;
CREATE VIEW q9 AS SELECT (s ~~ 'r%') AS a, (s !~~ 'r%') AS b, (s ~~* 'R%') AS c, (s || '!') AS d, -(i) AS e, 1.5 AS f, 'it''s' AS g, NULL AS h, CAST('t' AS BOOLEAN) AS j, 100000000000 AS k FROM base ORDER BY i;
